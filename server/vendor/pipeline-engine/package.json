{
  "name": "pipeline-engine-vendored",
  "version": "0.4.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:server": "bun --filter @archon/server dev",
    "start": "bun --filter @archon/server start",
    "dev:web": "bun --filter @archon/web dev",
    "build:web": "bun --filter @archon/web build",
    "type-check": "bun --filter '*' type-check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "^1.3.5",
    "typescript": "^5.3.0",
    "pino-pretty": "^13"
  },
  "engines": {
    "bun": "^1.3.0"
  },
  "overrides": {
    "test-exclude": "^7.0.1",
    "axios": "^1.15.0",
    "follow-redirects": "^1.16.0",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.1",
    "flatted": "^3.4.2",
    "@hono/node-server": "^1.19.13"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.173",
    "@opencode-ai/sdk": "^1.17.3"
