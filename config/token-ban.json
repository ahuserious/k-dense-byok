        "ARCHON_PI_AUTH_PATH",
        "ARCHON_SUPPRESS_NESTED_CLAUDE_WARNING",
        "ARCHON_TELEMETRY_DISABLED",
        "ARCHON_TOOL_SERVER",
        "ARCHON_TO_PI_OAUTH",
        "ARCHON_VERBOSE_BOOT",
