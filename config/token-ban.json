{
  "enabled": true,
  "token": "archon",
  "allowedPaths": [
    "server/vendor/pipeline-engine/**/LICENSE",
    "server/vendor/pipeline-engine/**/NOTICE*",
    "server/vendor/pipeline-engine/VENDORED-FROM.md"
  ],
  "allowedIdentifiers": [
    "ARCHON_BASE_URL",
    "KADY_ARCHON_PORT",
    "NEXT_PUBLIC_ARCHON_URL",
    "ARCHON_HOME",
    "ARCHON_SUPPRESS_NESTED_CLAUDE_WARNING",
    "@archon/server"
  ],
  "vendorInternalIdentifiers": [
    {
      "path": "server/vendor/pipeline-engine/**",
      "identifiers": [
        "@archon",
        "ARCHON_ALLOW_INTERNAL_ON_PUBLIC_BIND",
        "ARCHON_ALLOW_ORG_GITHUB_TOKEN_FALLBACK",
        "ARCHON_AUTH_ALLOWED_EMAILS",
        "ARCHON_AUTH_OPEN_SIGNUP",
        "ARCHON_CLAUDE_FIRST_EVENT_TIMEOUT_MS",
        "ARCHON_CODEX_MCP_TOKEN",
        "ARCHON_CODEX_MISSING_TOKEN",
        "ARCHON_CODEX_TEST_ENV",
        "ARCHON_DOCKER",
        "ARCHON_HOME",
        "ARCHON_ONLY_KEY",
        "ARCHON_PI_AUTH_PATH",
        "ARCHON_SUPPRESS_NESTED_CLAUDE_WARNING",
        "ARCHON_TELEMETRY_DISABLED",
        "ARCHON_TOOL_SERVER",
        "ARCHON_TO_PI_OAUTH",
        "ARCHON_VERBOSE_BOOT",
        "ARCHON_WEB_AUTH_HEADER",
        "ARCHON_WEB_AUTH_REQUIRED",
        ".archon",
        "archon.db",
        "archonPaths",
        "archonHome",
        "archonWork",
        "archonConfig",
        "archonEnv",
        "archonDocker",
        "archonUserId",
        "archonOwned",
        "archonUI",
        "archonMcp",
        "archonStarted",
        "archonActive",
        "archonAssist",
        "archonWorkflow",
        "archonDir",
        "archonCount",
        "archonAuth",
        "archon_sync",
        "archon_started",
        "archon_active",
        "archon_dashboard",
        "archon_notify",
        "archon_workflow",
        "archon.console"
      ]
    }
  ],
  "deprecatedCompatibilityIdentifiers": [
    {
      "path": "server/vendor/pipeline-engine/packages/server/src/routes/api.ts",
      "identifiers": ["X-Archon-User"],
      "comment": "deprecated-compat: previous default proxy identity header"
    },
    {
      "path": "server/vendor/pipeline-engine/packages/server/src/routes/api.auth.test.ts",
      "identifiers": ["X-Archon-User"],
      "comment": "deprecated-compat: coverage for previous default proxy identity header"
    },
    {
      "path": "server/vendor/pipeline-engine/packages/adapters/src/chat/slack/adapter.ts",
      "identifiers": ["/archon", "/archon-workflow"],
      "comment": "deprecated-compat: previous Slack slash-command aliases"
    },
    {
      "path": "server/vendor/pipeline-engine/packages/adapters/src/chat/slack/adapter.test.ts",
      "identifiers": ["/archon", "/archon-workflow"],
      "comment": "deprecated-compat: coverage for previous Slack slash-command aliases"
    },
    {
      "path": "server/src/api/dag-workflows.ts",
      "identifiers": ["legacy-archon"],
      "comment": "deprecated-compat: previous legacy-workflow preview route"
    },
    {
      "path": "server/test/dag-workflows-api.test.ts",
      "identifiers": ["legacy-archon"],
      "comment": "deprecated-compat: coverage for previous legacy-workflow preview route"
    },
    {
      "path": "docs/dag-workflows-legacy-migration.md",
      "identifiers": [".archon/workflows"],
      "comment": "deprecated-compat: documented legacy on-disk workflow location"
    }
  ]
}
