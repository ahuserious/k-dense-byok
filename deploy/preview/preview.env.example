# Hermetic preview ports (override with preview-up flags as needed).
KADY_PORT=18000
KADY_FRONTEND_PORT=13000
KADY_PIPELINE_ENGINE_PORT=13091

# preview-up replaces these examples with one unique /tmp/kady-preview-* root.
KADY_PROJECTS_ROOT=/tmp/kady-preview/projects
KADY_PI_AGENT_DIR=/tmp/kady-preview/pi-agent
PI_CODING_AGENT_DIR=/tmp/kady-preview/pi-agent

KADY_SKILLS_REPO=kady-preview-nonexistent/none
TELEGRAM_BOT_TOKEN=
KADY_PREVIEW=1
